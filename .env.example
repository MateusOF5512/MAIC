# Copie para .env na raiz e ajuste as URLs após criar os serviços no Render.
# No Render, configure estas mesmas variáveis no painel de cada serviço (não faça upload do .env).

# --- Backend (serviço Web Python, rootDir: BACKEND) ---
HOST=0.0.0.0
PORT=8091
DATA_FILE=./data/infrastructures.json
API_PREFIX=/api/v1
# Inclua a URL pública do frontend (local + Render)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://SEU-FRONTEND.onrender.com

# --- Frontend (serviço Web Node, rootDir: FRONTEND) ---
# Obrigatório no Render antes do build (NEXT_PUBLIC_* é embutido no build)
NEXT_PUBLIC_API_URL=https://SEU-BACKEND.onrender.com
